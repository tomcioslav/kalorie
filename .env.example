# Copy this file to .env and fill in real values for local dev.
# .env is gitignored — never commit real secrets.
#
# This app now runs as an always-on self-hosted server (uvicorn + SQLite),
# not on Lambda. In production the values below come from real environment
# variables managed by Terraform — .env is for local dev and tests only.
# Every value has a working default, EXCEPT the Cognito settings: without
# those, token verification cannot succeed and every authenticated request
# is rejected with 401 (see the COGNITO_* block below).

# Free key from https://api.data.gov/signup — the built-in default (DEMO_KEY)
# is rate-limited to ~30 requests/hour and will 429 quickly.
USDA_API_KEY=

# Where the SQLite database file lives. Defaults to calorie_tracker.db in the
# repo root — an absolute path, deliberately, so it does not move around with
# the process's working directory. Set this in production to point at the
# server's real data directory (e.g. /var/lib/calorie-tracker/calorie_tracker.db);
# whatever directory you choose must already exist and be writable.
# DATABASE_PATH=/var/lib/calorie-tracker/calorie_tracker.db

# Cognito — REQUIRED for real authentication. The server verifies each
# request's bearer JWT itself (fetching the pool's public JWKS and checking
# signature, issuer, client_id and token_use); there is no API Gateway doing
# it anymore. Left unset, JWKS URL construction fails and EVERY request with
# a token is rejected as invalid, so the server is effectively unusable
# except in ALLOW_ANONYMOUS_USER local-dev mode.
#
#   COGNITO_REGION        — AWS region hosting the user pool
#   COGNITO_USER_POOL_ID  — the user pool's id; forms the expected `iss`
#   COGNITO_APP_CLIENT_ID — expected `client_id` claim on access tokens
#
# In production these come from Terraform-managed environment variables,
# not from this file.
# COGNITO_REGION=eu-central-1
# COGNITO_USER_POOL_ID=eu-central-1_xxxxxxxxx
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS_REGION=eu-central-1

# Where uvicorn binds. Defaults to 127.0.0.1 (localhost-only, correct for
# production behind Caddy). Docker needs 0.0.0.0 to be reachable via port
# mapping — already set that way in docker-compose.yml, no need to repeat
# here unless you're running main.py outside Docker AND want it reachable
# from other machines.
# UVICORN_HOST=127.0.0.1
# UVICORN_PORT=8000

# Local dev only — lets MCP tools run without a real Cognito JWT, by
# accepting requests that carry NO token at all as a single shared local
# user. Set automatically by the test suite. It does NOT weaken anything
# for requests that DO carry a token: a present-but-invalid token is always
# rejected. Must stay unset in the real deployment.
# ALLOW_ANONYMOUS_USER=1
